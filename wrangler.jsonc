{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rania-ilove-u",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Stockage : mot de passe, annonce, progression de Rania.
  // Sans "id", wrangler crée le namespace KV automatiquement au premier deploy.
  "kv_namespaces": [{ "binding": "DB" }]
}
